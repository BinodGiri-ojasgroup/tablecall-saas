# Copy this file to .env. Never commit .env.
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENV=production
SECRET_KEY=replace-with-a-long-random-secret

# Local default; Docker Compose overrides DATABASE_URL to PostgreSQL.
DATABASE_URL=sqlite:///./tablecall.db

# Public address guests reach (used inside QR codes). Use your real HTTPS domain in production.
APP_BASE_URL=http://127.0.0.1:8000
COOKIE_SECURE=false

# Number of reverse proxies in front of the app (0 = none, 1 = Caddy/nginx/a cloud load balancer).
# Required for correct per-guest rate limiting behind a proxy; leave 0 when connecting directly.
TRUSTED_PROXY_COUNT=0

# First platform superadmin, created on a brand-new database.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-to-a-long-unique-password

# Optional tuning. PIN_TTL_MINUTES is only the starting default for restaurants that haven't chosen their own
# PIN rule; owners set it themselves under Settings (valid until the table closes, or a number of minutes).
PIN_TTL_MINUTES=15
RETENTION_DAYS=30

# Docker Compose only. Use a URL-safe password (letters/numbers).
POSTGRES_DB=tablecall
POSTGRES_USER=tablecall
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
# BIND_ADDRESS=127.0.0.1     # 0.0.0.0 exposes the app port to your network
# PORT=8000
# DOMAIN=tablecall.example.com   # for: docker compose --profile https up -d
